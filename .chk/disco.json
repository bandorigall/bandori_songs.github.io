u30ca\u30fc\u8b1b\u5ea7\u5287\u5834\u3001\u7279\u5225\u821e\u53f0\u6328\u62f6 \u30ad\u30e3\u30b9\u30c8\u30c8\u30fc\u30af\u756a\u7d44\uff08Blu-ray ver.\uff09\u3092\u3042\u308f\u305b\u3066\u53ce\u9332\u3002<br \/>\n\u5404\u6620\u50cf\u306b\u306f\u300c\u30d0\u30ea\u30a2\u30d5\u30ea\u30fc\u65e5\u672c\u8a9e\u30fb\u82f1\u8a9e\u30fb\u97d3\u56fd\u8a9e\u30fb\u4e2d\u56fd\u8a9e\u7e41\u4f53\u5b57\u30fb\u4e2d\u56fd\u8a9e\u7c21\u4f53\u5b57\u300d\u306e\u5b57\u5e55\u3082\u53ce\u9332\u3002<\/p>\n<p>\u3055\u3089\u306b\u3001\u4f5c\u54c1\u306e\u4e16\u754c\u89b3\u3092\u9bae\u3084\u304b\u306b\u5f69\u308b\u5287\u4f34\u697d\u66f213\u66f2\u3092\u53ce\u3081\u305f\u30b5\u30a6\u30f3\u30c9\u30c8\u30e9\u30c3\u30af\u3082\u4ed8\u5c5e\u3055\u308c\u3066\u304a\u308a\u3001<br \/>\n\u5287\u5834\u3067\u3057\u304b\u5473\u308f\u3048\u306a\u304b\u3063\u305f\u71b1\u6c17\u3068\u8208\u596e\u3092\u3001\u3054\u81ea\u5b85\u3067\u4f55\u5ea6\u3067\u3082\u304a\u697d\u3057\u307f\u3044\u305f\u3060\u3051\u308b\u5b8c\u5168\u4fdd\u5b58\u7248\u30d1\u30c3\u30b1\u30fc\u30b8\u3068\u306a\u3063\u3066\u3044\u307e\u3059\u3002<\/p>\n<p>\u300cBanG Dream! It's MyGO!!!!! \/ Ave Mujica\u300d\u7d9a\u7de8TV\u30a2\u30cb\u30e1\u306e\u653e\u9001\u524d\u306b\u305c\u3072\u3054\u89a7\u304f\u3060\u3055\u3044\u3002<\/p>\n<h2 class=\"tpcs parts-root\">\u30b8\u30e3\u30b1\u30c3\u30c8<\/h2>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-large wp-image-29168\" src=\"https:\/\/bang-dream.com\/wordpress\/wp-content\/uploads\/2026\/10\/23135814\/3c53d1fa-25707ca3-9c89322e-9a47cde1-733x1024.png\" alt=\"\" width=\"733\" height=\"1024\" \/><\/p>\n<h2 class=\"tpcs parts-root\">\u53ce\u9332\u5185\u5bb9<\/h2>\n<h6 class=\"tpcs parts-root\">Blu-ray<\/h6>\n<p>\u30fb\u6620\u753b\u300cBanG Dream! Ave Mujica prima aurora\u300d\u672c\u7de8\u6620\u50cf<br \/>\n\u30fbAve Mujica \u30de\u30ca\u30fc\u8b1b\u5ea7\u5287\u5834<br \/>\n\u30fb\u7279\u5225\u821e\u53f0\u6328\u62f6 \u30ad\u30e3\u30b9\u30c8\u30c8\u30fc\u30af\u756a\u7d44\uff08Blu-ray ver.\uff09<\/p>\n<p>\u30fb\u53ce\u9332\u5b57\u5e55<br \/>\n1) \u30d0\u30ea\u30a2\u30d5\u30ea\u30fc\u65e5\u672c\u8a9e\u5b57\u5e55<br \/>\n2) \u82f1\u8a9e\u5b57\u5e55<br \/>\n3) \u97d3\u56fd\u8a9e\u5b57\u5e55<br \/>\n4) \u4e2d\u56fd\u8a9e\u7e41\u4f53\u5b57\u5b57\u5e55<br \/>\n5) \u4e2d\u56fd\u8a9e\u7c21\u4f53\u5b57\u5b57\u5e55<\/p>\n<p>\u30fb\u53ce\u9332\u97f3\u58f0<br \/>\n1) \u30ea\u30cb\u30a2PCM(2.0ch)<br \/>\n2) \u30ea\u30cb\u30a2PCM(5.1ch)<br \/>\n\u203b\u30ea\u30cb\u30a2PCM(5.1ch)\u306f\u6620\u753b\u300cBanG Dream! Ave Mujica prima aurora\u300d\u672c\u7de8\u6620\u50cf\u3067\u306e\u307f\u5207\u308a\u66ff\u3048\u53ef\u80fd\u3067\u3059\u3002<br \/>\n\u203b\u30ea\u30cb\u30a2PCM(5.1ch)\u306f\u5bfe\u5fdc\u6a5f\u7a2e\u30fb\u74b0\u5883\u3067\u306e\u307f\u518d\u751f\u53ef\u80fd\u3067\u3059\u3002<br \/>\n\u3000\u672a\u5bfe\u5fdc\u306e\u6a5f\u7a2e\u3092\u4f7f\u7528\u3057\u305f\u5834\u5408\u3001\u30e1\u30cb\u30e5\u30fc\u753b\u9762\u3067\u30ea\u30cb\u30a2PCM(5.1ch)\u3092\u9078\u629e\u3055\u308c\u305f\u3068\u3057\u3066\u3082\u30ea\u30cb\u30a2PCM(2.0ch)\u3067\u306e\u518d\u751f\u3068\u306a\u308a\u307e\u3059\u3002<br \/>\n\u3000\u304a\u6301\u3061\u306e\u6a5f\u7a2e\u304c\u30ea\u30cb\u30a2PCM(5.1ch)\u306e\u518d\u751f\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u308b\u304b\u306b\u95a2\u3057\u3066\u306f\u3001\u5404\u767a\u58f2\u30e1\u30fc\u30ab\u30fc\u306b\u304a\u554f\u3044\u5408\u308f\u305b\u304f\u3060\u3055\u3044\u3002<\/p>\n<h6>CD<\/h6>\n<p>\u30fb\u5287\u4f34\u53ce\u9332\u30b5\u30a6\u30f3\u30c9\u30c8\u30e9\u30c3\u30afCD<br \/>\n1. Overture<br \/>\n2. \u51a5\u754c\u3078\u306e\u8a98\u3044<br \/>\n3. \u8840\u306e\u796d\u5100<br \/>\n4. \u5e55\u9593\u306e\u7d20\u9854<br \/>\n5. \u685c\u54b2\u304f\u591c\u9053<br \/>\n6. \u76db\u8005\u5fc5\u8870<br \/>\n7. \u3082\u3046\u4e00\u3064\u306e\u9854<br \/>\n8. \u7dca\u5f35\u3068\u7de9\u548c<br \/>\n9. \u30a2\u30f3\u30c6\u30a3\u30fc\u30af\u30fb\u30d5\u30a1\u30f3\u30c8\u30e0<br \/>\n10. \u304a\u304b\u3048\u308a\u306a\u3055\u3044\uff01<br \/>\n11. \u72ec\u7acb\u5ba3\u8a00<br \/>\n12. \u30b0\u30e9\u30b9\u3092\u7247\u624b\u306b<br \/>\n13. \u5d29\u308c\u51fa\u3059\u65e5\u5e38<\/p>\n<h2 class=\"tpcs parts-root\">\u521d\u56de\u751f\u7523\u5206\u9650\u5b9a\u5c01\u5165\u7279\u5178<\/h2>\n<p>\u30fb\u30b9\u30da\u30b7\u30e3\u30eb\u30d6\u30c3\u30af\u30ec\u30c3\u30c8<br \/>\n\u30fb\u7279\u88fd\u30b8\u30e3\u30b1\u30c3\u30c8\u30b9\u30c6\u30c3\u30ab\u30fc1\u679a<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-29170 size-medium\" src=\"https:\/\/bang-dream.com\/wordpress\/wp-content\/uploads\/2026\/10\/23140523\/3ca7ba71-30740515-9d45400a-b8b65a43-271x300.jpg\" alt=\"\" width=\"271\" height=\"300\" \/><\/p>\n<h2 class=\"tpcs parts-root\">\u5546\u54c1\u4ed5\u69d8<\/h2>\n<p>\u30fb\u7279\u88fd\u304f\u308b\u307f\u4e09\u65b9\u80cc\u30b9\u30ea\u30fc\u30d6\u30b1\u30fc\u30b9\u4ed5\u69d8<\/p>\n<h2 class=\"tpcs parts-root\">\u65e9\u671f\u4e88\u7d04\u7279\u5178<\/h2>\n<p class=\"tpcs\">\u30fb\u30df\u30cb\u30d5\u30a9\u30c8\u98a8\u30ab\u30fc\u30c9(5\u7a2e\u30bb\u30c3\u30c8)<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-29288\" src=\"https:\/\/bang-dream.com\/wordpress\/wp-content\/uploads\/2026\/10\/29165523\/0e863464-a612bef6-f865bd3f-4a7cc582.jpg\" alt=\"\" width=\"1000\" height=\"959\" \/><\/p>\n<p class=\"tpcs\"><strong>\u4e88\u7d04\u671f\u9593<\/strong><br \/>\n2026\u5e7410\u670824\u65e5(\u571f)\uff5e11\u670822\u65e5(\u65e5) 23:59\u307e\u3067<\/p>\n<p class=\"tpcs\">\u203b\u78ba\u5b9f\u306b\u624b\u306b\u5165\u308c\u305f\u3044\u65b9\u306f\u671f\u9593\u5185\u306b\u3054\u4e88\u7d04\u304f\u3060\u3055\u3044\u3002<br \/>\n\u203b\u4e88\u7d04\u7279\u5178\u306e\u5728\u5eab\u306b\u95a2\u3059\u308b\u304a\u554f\u3044\u5408\u308f\u305b\u306f\u3001\u5404\u6cd5\u4eba\u69d8\u307e\u3067\u304a\u5c0b\u306d\u304f\u3060\u3055\u3044\u3002<\/p>\n<h2 class=\"tpcs parts-root\">\u6cd5\u4eba\u5225\u7279\u5178<\/h2>\n<p>\u25bc\u30d6\u30b7\u30ed\u30fc\u30c9 \u30aa\u30f3\u30e9\u30a4\u30f3\u30b9\u30c8\u3